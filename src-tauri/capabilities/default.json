{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [{ "path": "$TEMP/*" }] },
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$TEMP/*" }] }
  ]
}
